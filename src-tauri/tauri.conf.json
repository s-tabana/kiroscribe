{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiroscribe",
  "version": "../package.json",
  "identifier": "dev.kiroscribe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiroscribe",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "AI 会議メモ",
    "longDescription": "会議の音声を文字起こしし、自分のメモと合わせて AI が議事録に仕上げるデスクトップアプリ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzODQ2MzU2RTVCNTYxMkIKUldRclliWGxWbU9Fb3lWcEpnWlQ5TkpzakgzOFpsNU9vY3NCVjZuWXMvQ01ZR29xb0pUc2M1amQK",
      "endpoints": [
        "https://github.com/s-tabana/kiroscribe/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
