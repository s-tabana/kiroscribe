{
  "name": "kiroscribe",
  "private": true,
  "version": "0.4.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "build:e2e": "tauri build --debug --no-bundle --features e2e --config scripts/tauri.ci.conf.json",
    "test:e2e": "node e2e/run.mjs",
    "build:e2e:installer": "node e2e/installer/build.mjs",
    "test:e2e:installer": "node e2e/installer/run.mjs",
    "test": "npm run test:web && npm run test:rust",
    "test:web": "vitest run",
    "test:web:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reportsDirectory=target/coverage-web --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.include=src/**/*.ts --coverage.include=src/**/*.tsx --coverage.exclude=src/**/*.test.ts --coverage.exclude=src/**/*.test.tsx --coverage.exclude=src/test/**",
    "test:rust": "cargo test --workspace"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
